# Simply NALLY — copy to .env and fill in
# Provider: "openai" | "groq" | "opencode" (https://opencode.ai/zen) | "nvidia" (https://integrate.api.nvidia.com)
NALLY_PROVIDER=nvidia
NVIDIA_API_KEY=nvapi-...
NALLY_MODEL=nvidia/nemotron-3-super-120b-a12b

# Optional overrides
# OPENAI_BASE_URL=https://api.openai.com/v1
# NALLY_MAX_ITERATIONS=10
# NALLY_MAX_TOOL_CALLS=20

# --- Session persistence (NEON Postgres) ---
# One session per user (v1). Set DATABASE_URL to enable cloud persistence.
# Get it from https://console.neon.tech — Connection String (pooled).
# Example: postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL=postgresql://...

# --- Google OAuth (Desktop flow, CLI + browser) ---
# Create a Desktop OAuth client at https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxx

# --- Telegram Bot (polling) ---
# TELEGRAM_BOT_TOKEN=123456789:AAH...  (keep secret)
# Run: python main.py telegram

# --- Telegram Bot (webhook, Render/production) ---
# BOT_MODE=webhook
# WEBHOOK_BASE_URL=https://simply-nally.onrender.com  (your Render service URL)
# OAUTH_BASE_URL=https://simply-nally.onrender.com  (same as WEBHOOK_BASE_URL, for OAuth callbacks)
# PORT is set automatically by Render — do NOT set manually.

# --- MCP v2 — browser-only OAuth (no device flow) ---
# Create OAuth apps:
#   GitHub: https://github.com/settings/developers → OAuth App (Authorization callback: https://your-domain/oauth/callback/github)
#   Google: https://console.cloud.google.com/apis/credentials → Web Application (Authorized redirect: https://your-domain/oauth/callback/gmail)
#   Notion: https://www.notion.com/my-integrations → Public integration (Redirect URI: https://your-domain/oauth/callback/notion)
#
# For local CLI testing, the redirect is loopback (http://127.0.0.1:{port}/callback) — no OAUTH_BASE_URL needed.
# For deployed Telegram bot, set OAUTH_BASE_URL to your public HTTPS URL.

# Vault envelope encryption — generate a 32-byte base64 key:
#   python -m nally.vault.crypto
# Keep this secret. Changing it invalidates existing encrypted credentials (users must reconnect).
# NALLY_VAULT_MASTER_KEY=base64url-32-byte-key

# Browser-only flag (default true). Set false to re-enable legacy device flow for migration only.
# NALLY_AUTH_V2=true

# Allow environment token fallback in multi-user mode (disabled by default).
# For single-user local dev, set true to allow GITHUB_TOKEN etc. In production, keep false.
# NALLY_ALLOW_ENV_FALLBACK=false

# OAuth callback base (production) — single HTTPS endpoint for all providers
# OAUTH_BASE_URL=https://simply-nally.onrender.com
# OAUTH_CALLBACK_PORT=8080  (local only, when OAUTH_BASE_URL not set)

# GitHub OAuth (Web flow — not Device Flow)
# GITHUB_CLIENT_ID=Ov23liUcAUqnmhdTZNMG
# GITHUB_CLIENT_SECRET=c3a3cc8a7b48b4c49b05966f3865a856a02d6375
# GITHUB_OAUTH_SCOPES=read:user,repo

# Gmail OAuth (Google Web flow, scopes: gmail.readonly + gmail.compose)
# GMAIL_CLIENT_ID=xxx.apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=xxx
# GMAIL_OAUTH_SCOPES=https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.compose
# GMAIL_MCP_URL=https://gmailmcp.googleapis.com/mcp

# Notion OAuth (PKCE + discovery, dynamic registration if NOTION_CLIENT_ID not set)
# NOTION_CLIENT_ID=xxx
# NOTION_CLIENT_SECRET=xxx
# NOTION_OAUTH_SCOPES=
# NOTION_MCP_URL=https://mcp.notion.com/mcp

# --- MCP servers (transport only, no credentials) ---
# NALLY_MCP_ENABLED=true
# GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
# GITHUB_TOOLSETS=repos,issues,pull_requests
# GITHUB_READ_ONLY=false
# NALLY_MCP_DENY=delete_repository,delete_message,delete_thread,batch_delete_messages,batch_delete_emails,delete_draft,delete_label,delete_filter
# NALLY_MCP_TIMEOUT=30
# NALLY_MCP_SERVERS={"github":{"url":"https://api.githubcopilot.com/mcp/"},"gmail":{"url":"https://gmailmcp.googleapis.com/mcp"}}

# --- Deprecated (device flow, will be removed) ---
# GOOGLE_DEVICE_CLIENT_ID=xxx  (deprecated — use Web flow + OAUTH_BASE_URL)
# GOOGLE_DEVICE_CLIENT_SECRET=xxx
# GITHUB_TOKEN=ghp_xxx  (deprecated — use `python main.py mcp connect github`)
# GMAIL_TOKEN=ya29...  (deprecated — use `python main.py mcp connect gmail`)
# NOTION_TOKEN=ntn_...  (Notion REST fallback when MCP OAuth fails — internal integration secret)
# Share pages/databases with the integration in Notion. Prefer this if browser OAuth shows Invalid MCP state.
