# Simply NALLY — copy to .env and fill in
# Provider: "openai" | "groq" | "opencode" (https://opencode.ai/zen) | "nvidia" (https://integrate.api.nvidia.com)
NALLY_PROVIDER=nvidia
# Nvidia NIM (2026-08-31 tested: super 120b 3.3s, 3.5-lightning 22-39s, deepseek 79s timeout)
# super: 3.0s (thinking False) / 3.3s tool / 7.5s limerick; best for latency
NVIDIA_API_KEY=nvapi-...
NALLY_MODEL=nvidia/nemotron-3-super-120b-a12b
# Groq example:
# NALLY_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# OpenAI example:
# NALLY_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# NALLY_MODEL=gpt-4o-mini
# Opencode (Zen) — free tier 2026-08-31: ling-3.0-flash-fin-free (flaky 503), mimo-v2.5-free (429), muse-spark-1.2-contributor-free (500)
# NALLY_PROVIDER=opencode
# OPENCODE_API_KEY=sk-Vmcj...,sk-Apo...
# NALLY_MODEL=ling-3.0-flash-fin-free  # needs max_tokens >= 4096, hy3-free retired

# Optional overrides
# OPENAI_BASE_URL=https://api.openai.com/v1
# NALLY_MAX_ITERATIONS=10
# NALLY_MAX_TOOL_CALLS=20

# --- Session persistence (NEON Postgres) ---
# One session per user (v1). Set DATABASE_URL to enable cloud persistence.
# Get it from https://console.neon.tech — Connection String (pooled).
# Example: postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL=postgresql://...

# --- Google OAuth (Desktop flow, CLI + browser) ---
# Create a Desktop OAuth client at https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxx

# --- Google OAuth Device Flow (for Telegram /link, shared session) ---
# Create a SECOND client at https://console.cloud.google.com/apis/credentials
# Type: "TVs and Limited Input devices" (NOT Desktop). Same project is fine.
# GOOGLE_DEVICE_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_DEVICE_CLIENT_SECRET=xxx

# --- Telegram Bot (polling, no server) ---
# Create a bot via @BotFather on Telegram, get the token, set it here.
# TELEGRAM_BOT_TOKEN=123456789:AAH...  (keep secret)
# Run: python main.py telegram

# --- GitHub MCP OAuth (permanent device flow) ---
# Register an OAuth App at https://github.com/settings/developers
# Enable Device Flow in the app settings.
# This is the PERMANENT auth for MCP — token cached at ~/.config/simply-nally/github_oauth_token.json (0600)
# CLI: python main.py mcp login  |  Telegram: /mcp → GitHub: Not Authenticated
# GITHUB_CLIENT_ID=Ov23liUcAUqnmhdTZNMG
# GITHUB_CLIENT_SECRET=c3a3cc8a7b48b4c49b05966f3865a856a02d6375
# GITHUB_OAUTH_SCOPES=repo,read:user,workflow  # least-privilege for permanent use; broad default is repo,read:user,workflow,pull_requests,issues

# --- Notion MCP — NOTION_TOKEN for local stdio, NOTION_MCP_URL for remote ---
# Register a Notion integration at https://developers.notion.com/docs/integrations
# NOTION_TOKEN=ntn_***
# NOTION_MCP_URL=https://mcp.notion.com/mcp
# Optional: local stdio fallback (takes precedence over URL)
# NOTION_MCP_COMMAND=npx
# NOTION_MCP_ARGS=-y @notionhq/notion-mcp-server

# --- MCP — GitHub (permanent device flow, remote Streamable HTTP default) ---
# NALLY_MCP_ENABLED=true  # keep true for permanent MCP
# GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
# Permanent auth is device flow (see above) — PAT is OPTIONAL override only:
# GITHUB_PERSONAL_ACCESS_TOKEN=ghp_xxx  # if set, overrides cached OAuth token
# Optional: filter toolsets (default: repos,issues,pull_requests,users,context via server default)
# GITHUB_TOOLSETS=repos,issues,pull_requests
# Optional: read-only (blocks destructive: create PR, merge, push)
# GITHUB_READ_ONLY=false
# Optional: local stdio fallback (takes precedence over URL)
# GITHUB_MCP_COMMAND=docker
# GITHUB_MCP_ARGS=run -i --rm -e GITHUB_PERSONAL_ACCESS_TOKEN ghcr.io/github/github-mcp-server
# Alternative: NALLY_MCP_SERVERS JSON map (overrides per-server env above)
# NALLY_MCP_SERVERS={"github":{"url":"https://api.githubcopilot.com/mcp/","headers":{"Authorization":"Bearer ghp_xxx"}}}
# NALLY_MCP_DENY=delete_repository,batch_delete_emails,delete_email
# NALLY_MCP_TIMEOUT=30
